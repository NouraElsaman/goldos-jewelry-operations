# GoldOS — Environment Variables
#
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is git-ignored and should never be committed.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Service Provider ──────────────────────────────────────────────────────────
#
# Controls which data source the application uses at runtime.
#
#   mock  → In-memory fixtures (src/services/mock/).
#           No backend required. Default for local development and design review.
#
#   http  → Live FastAPI backend.
#           Requires VITE_API_URL to also be set.
#           Use once the backend is running.
#
VITE_SERVICE_PROVIDER=mock

# ── API Base URL ──────────────────────────────────────────────────────────────
#
# Base URL for the FastAPI backend.
# Required when VITE_SERVICE_PROVIDER=http.
# Do NOT include a trailing slash.
#
# Examples:
#   Local development:  http://localhost:8000
#   Staging:            https://api.staging.goldos.sa
#   Production:         https://api.goldos.sa
#
# VITE_API_URL=http://localhost:8000
